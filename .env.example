# Password for the remote desktop and the phone view. Use a long random value,
# for example the output of: openssl rand -hex 16
WEB_PASSWORD=change-me

# User and group that own the config/ directory on the host.
PUID=1000
PGID=1000

# The multi-architecture base image selects linux/amd64 or linux/arm64 automatically.
# Pin a tested upstream tag or multi-platform manifest digest for repeatable rebuilds.
BASE_IMAGE=ghcr.io/linuxserver/weixin@sha256:ef55da929cab5fae1f45b902b94918234604fa1473a7a7322383614a51573059
TZ=Asia/Shanghai
HTTP_PORT=5804
MEM_LIMIT=4g
SHM_SIZE=1gb
