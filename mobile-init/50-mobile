#!/usr/bin/with-contenv bash
set -e
/custom-services.d/mobile/python - <<'PY'
from pathlib import Path
import re
p=Path('/etc/nginx/sites-enabled/default')
s=p.read_text()
web_root = '/var/www/nas-chat-mobile/' if Path('/var/www/nas-chat-mobile').is_dir() else '/config/mobile/web/'
web_marker = '# mobile-static-root=' + web_root
if '# mobile-session-v12' not in s or web_marker not in s:
    s=re.sub(r'  # mobile-wechat\n.*?(?=  location / \{)', '', s, flags=re.S)
    s=re.sub(r'  auth_basic\s+"Login";\n', '', s)
    s=re.sub(r'  auth_basic_user_file\s+/etc/nginx/.htpasswd;\n', '', s)
    block=r'''  # mobile-wechat
  # mobile-session-v12
  absolute_redirect off;
  auth_request /_mobile_auth;
  location = /_mobile_auth {
    internal;
    auth_request off;
    proxy_pass http://127.0.0.1:8089/auth-check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
  }
  location = /mobile/login {
    auth_request off;
    alias /config/mobile/web/login.html;
    default_type text/html;
    add_header Cache-Control "no-store" always;
  }
  location = /_mobile_login_redirect {
    internal;
    auth_request off;
    return 302 /mobile/login;
  }
  location = /session/login {
    auth_request off;
    proxy_pass http://127.0.0.1:8089/login;
    client_max_body_size 32k;
  }
  location = / { return 302 /mobile/; }
  location = /apple-touch-icon.png {
    auth_request off;
    alias /config/mobile/web/apple-touch-icon.png;
    add_header Cache-Control "no-cache" always;
  }
  location = /apple-touch-icon-precomposed.png {
    auth_request off;
    alias /config/mobile/web/apple-touch-icon.png;
    add_header Cache-Control "no-cache" always;
  }
  location = /favicon.ico {
    auth_request off;
    alias /config/mobile/web/favicon.png;
    types { }
    default_type image/png;
    add_header Cache-Control "no-cache" always;
  }
  location = /mobile/lan-config.json {
    auth_request off;
    alias /config/mobile/web/lan-config.json;
    default_type application/json;
    add_header Cache-Control "no-store" always;
  }
  location ~ ^/mobile/((apple-touch-icon|favicon|icon|icon-192)\.png|manifest\.json)$ {
    auth_request off;
    alias /config/mobile/web/$1;
    add_header Cache-Control "public, max-age=86400" always;
  }
  location = /mobile/lan-setup.html {
    auth_request off;
    alias /config/mobile/web/lan-setup.html;
    default_type text/html;
    add_header Cache-Control "no-store" always;
  }
  location = /mobile/lan-root.cer {
    auth_request off;
    alias /config/mobile/web/lan-root.cer;
    types { }
    default_type application/x-x509-ca-cert;
  }
  location = /mobile/lan-chat.mobileconfig {
    auth_request off;
    alias /config/mobile/web/lan-chat.mobileconfig;
    types { }
    default_type application/x-apple-aspen-config;
  }
  location /mobile/ {
    alias /config/mobile/web/;
    index index.html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    error_page 401 = /_mobile_login_redirect;
  }
  location = /mobile-api/upload {
    proxy_pass http://127.0.0.1:8089/upload;
    client_max_body_size 100m;
    client_body_timeout 120s;
    proxy_read_timeout 120s;
  }
  location = /mobile-api/ws {
    proxy_pass http://127.0.0.1:8089/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_buffering off;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
  location = /mobile-api/stream {
    proxy_pass http://127.0.0.1:8089/stream;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    gzip off;
  }
  location /mobile-api/ {
    proxy_pass http://127.0.0.1:8089/;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    client_max_body_size 32k;
    proxy_read_timeout 30s;
  }
'''
    block=block.replace('/config/mobile/web/', web_root).replace('# mobile-session-v12', '# mobile-session-v12\n  ' + web_marker)
    s=s.replace('  location / {',block+'  location / {')
    p.write_text(s)
PY
mkdir -p /run/wechat-mobile-service
cp /custom-services.d/mobile/run /run/wechat-mobile-service/run
chmod 755 /run/wechat-mobile-service/run
if ! s6-svok /run/wechat-mobile-service >/dev/null 2>&1; then
  nohup s6-supervise /run/wechat-mobile-service >/dev/null 2>&1 &
fi
